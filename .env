# All three settings are optional; the defaults below are used when unset.
# Relative paths are resolved against the project directory, not the shell's
# current directory, and a leading "~" expands to your home directory.

# File holding one URL per line (# starts a comment).
LINKS_FILE=links.txt

# Per-media download directories.
VIDEO_DIR=~/Movies
AUDIO_DIR=~/Music

# Where the yt-dlp binary lives. Defaults to ./bin/<platform-specific name>,
# so leave this unset unless you want to reuse an existing yt-dlp install.
# YTDLP_PATH=./bin/yt-dlp
